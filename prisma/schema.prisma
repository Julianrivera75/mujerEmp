datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MENTOR
  STUDENT
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum ClassStatus {
  PROGRAMADA
  FINALIZADA
  CANCELADA
}

enum ResourceType {
  YOUTUBE
  DOCUMENT
  LINK
}

enum FileType {
  PDF
  DOC
  IMAGE
  LINK
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(STUDENT)
  // Roles adicionales de la misma cuenta (por ejemplo, una mentora que también es estudiante)
  extraRoles   Role[]     @default([])
  status       UserStatus @default(ACTIVO)
  memberNumber String?    @map("documentId")
  phone        String?
  avatar       String?
  startDate    DateTime? // Fecha de inicio en la plataforma
  endDate      DateTime? // Fecha de finalización

  // Autorización de tratamiento de datos y términos (Ley 1581 de 2012)
  termsAcceptedAt    DateTime?
  termsVersion       String?
  // Menores de edad: requiere autorización del representante legal
  isMinor            Boolean   @default(false)
  guardianName       String?
  guardianContact    String?
  guardianConsentAt  DateTime?
  // Supresión de datos: la cuenta se anonimiza en lugar de borrarse
  anonymizedAt       DateTime?
  // Se incrementa al cambiar la contraseña, desactivar o anonimizar: invalida las sesiones abiertas
  tokenVersion       Int       @default(0)
  // La persona debe cambiar su contraseña en el próximo ingreso (contraseña inicial o restablecida por la administración)
  mustChangePassword Boolean   @default(false)
  // Presencia y preferencias de avisos
  lastSeenAt         DateTime?
  showOnlineStatus   Boolean   @default(true)
  emailNotifications Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentoredClasses    ClassSession[]    @relation("MentorClasses")
  enrolledClasses    ClassEnrollment[]
  attendances        Attendance[]
  submissions        Submission[]
  createdAssignments Assignment[]      @relation("MentorAssignments")
  conversationsA     Conversation[]    @relation("ConversationA")
  conversationsB     Conversation[]    @relation("ConversationB")
  messagesSent       Message[]
  notifications      Notification[]
}

// Intentos de inicio de sesión fallidos: limitan la fuerza bruta entre reinicios y réplicas
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model ClassSession {
  id             String      @id @default(cuid())
  title          String
  description    String?
  dateStart      DateTime
  dateEnd        DateTime
  meetLink       String? // Link de Google Meet
  youtubeUrl     String? // Link de YouTube para la grabación
  recordingNotes String?
  // Afiche o imagen de la clase (clave del archivo en el almacenamiento)
  imageKey       String?
  status         ClassStatus @default(PROGRAMADA)
  monthKey       String // Formato YYYY-MM para agrupamiento mensual

  mentorId String
  mentor   User   @relation("MentorClasses", fields: [mentorId], references: [id], onDelete: Restrict)

  enrollments ClassEnrollment[]
  attendances Attendance[]
  assignments Assignment[]
  resources   ClassResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mentorId])
  @@index([monthKey])
  @@index([dateStart])
}

model ClassEnrollment {
  id           String       @id @default(cuid())
  classId      String
  studentId    String
  classSession ClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([classId, studentId])
  @@index([studentId])
}

model Attendance {
  id           String       @id @default(cuid())
  classId      String
  studentId    String
  joinedAt     DateTime     @default(now()) // Hora exacta de clic al enlace de Google Meet
  classSession ClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
  @@index([joinedAt])
}

model Assignment {
  id           String       @id @default(cuid())
  classId      String
  creatorId    String
  title        String
  description  String
  dueDate      DateTime
  classSession ClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  creator      User         @relation("MentorAssignments", fields: [creatorId], references: [id], onDelete: Restrict)
  submissions  Submission[]
  createdAt    DateTime     @default(now())

  @@index([classId])
  @@index([creatorId])
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  submittedAt  DateTime   @default(now())
  fileUrl      String?
  fileType     FileType?
  notes        String?
  grade        Float? // Calificación otorgada
  feedback     String? // Comentarios de retroalimentación
  gradedAt     DateTime?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model ClassResource {
  id           String       @id @default(cuid())
  classId      String
  title        String
  type         ResourceType
  url          String
  classSession ClassSession @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@index([classId])
}

// Conversación 1 a 1: userAId siempre es el id menor, para que cada pareja tenga una sola conversación
model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  userA         User      @relation("ConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User      @relation("ConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime?
  lastReadAtA   DateTime?
  lastReadAtB   DateTime?
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum NotificationType {
  NEW_ASSIGNMENT
  ASSIGNMENT_DUE_SOON
  SUBMISSION_RECEIVED
  SUBMISSION_GRADED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  // Ruta a la que lleva la notificación al pulsarla
  href      String
  // Evita duplicar el mismo aviso (por ejemplo "por vencer" de la misma tarea)
  dedupeKey String
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}
