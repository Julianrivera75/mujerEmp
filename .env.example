# Postgres (Railway inyecta esta variable automáticamente al conectar el plugin Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/empoderas_diversas?schema=public"

# Secreto para firmar JWT de sesión (generar uno fuerte, no usar el default del código)
JWT_SECRET="reemplazar-con-un-valor-aleatorio-largo"

NODE_ENV="development"
