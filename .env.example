# PostgreSQL (Railway la inyecta automáticamente al enlazar la base de datos)
DATABASE_URL="postgresql://user:password@localhost:5432/empoderas_diversas?schema=public"

# Secreto para firmar la sesión. Obligatorio en producción. Generar uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="reemplazar-con-un-valor-aleatorio-largo"

# Almacenamiento de archivos compatible con S3 (necesario para entregas, materiales y fotos)
S3_ENDPOINT="https://endpoint.del.proveedor"
S3_REGION="auto"
S3_ACCESS_KEY_ID="reemplazar"
S3_SECRET_ACCESS_KEY="reemplazar"
S3_BUCKET_NAME="reemplazar"

# Muestra los accesos rápidos de demostración en el login. Solo desarrollo local.
# Es una variable de compilación: no definirla en producción.
NEXT_PUBLIC_SHOW_DEMO_LOGIN="false"

NODE_ENV="development"
